{
  "name": "cs-portrait-archive",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run build:web",
    "build:web": "npm run prepare:assets && tsc --noEmit && node scripts/prepare-public.mjs && vite build && node scripts/package-web.mjs",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "build:offline": "npm run build:web && node scripts/package-offline.mjs",
    "check:data": "node scripts/audit.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "npm run test:web",
    "test:web": "playwright test -c playwright.web.config.ts",
    "preview": "vite preview",
    "test:offline": "playwright test app.spec.ts",
    "collect:album": "node scripts/download-album-queue.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "motion": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.0",
    "prettier": "^3.9.10",
    "sharp": "^0.33.5",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
